# ROMM environment secrets
# Do NOT commit this file to git

# Database
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ROMM auth — regenerated from default
ROMM_AUTH_SECRET_KEY=

# IGDB API (Twitch dev console)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# OIDC client secret — must match the hashed value in authelia/config/configuration.yml
# Generate with: openssl rand -hex 32
OIDC_CLIENT_SECRET=
