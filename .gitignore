# ── Secrets — NEVER commit these ──────────────────────────────
.env
*.env
!.env.example          # but DO commit env templates
*.key
*.pem
*.p12
*.pfx
*-credentials.json     # cloudflared tunnel creds (if ever symlinked here)

# ── App data / live state ──────────────────────────────────────
# Bind-mount destinations: these are runtime data, not config-as-code.
**/config/
**/data/
**/db/
**/assets/
**/logs/
authelia/config/db/
authelia/config/notification.txt
authelia/config/authelia.log
romm/db/
romm/assets/
romm/logs/
stash/

# ── Stale local arr config (the live one is on /Volumes/Orange) ──
arr-stack/config/

# ── Database / runtime files ──────────────────────────────────
*.db
*.db-shm
*.db-wal
*.pid
*.sock
*.lock

# ── Crash dumps / log captures ────────────────────────────────
Sentry/
**/Sentry/
asp/
*.log

# ── Backups ───────────────────────────────────────────────────
*.bak
*.bak.*
*.backup
*.backup.*
docker-compose.yml.bak*

# ── Docker-managed volumes (in case any leak as bind mounts) ───
caddy_data/
caddy_config/
lldap_data/

# ── OS noise ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ── Health check log ──────────────────────────────────────────
scripts/.healthcheck.log
